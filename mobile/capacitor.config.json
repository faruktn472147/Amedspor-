{
  "appId": "com.amedtaraftar.app",
  "appName": "AMEDSPOR Taraftar",
  "webDir": "www",
  "backgroundColor": "#0a0d0b",
  "android": {
    "allowMixedContent": false,
    "captureInput": false,
