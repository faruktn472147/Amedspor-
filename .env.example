# ============================================================================
# AMEDSPOR — Ortam değişkenleri ÖRNEĞİ
# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local GitHub'a YÜKLENMEZ (.gitignore). Gerçek anahtarları buraya yazmayın.
# ============================================================================

# Sitenin adresi (yerelde http://localhost:3000, yayında https://alanadiniz)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Free plan) — Project Settings > API ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GİZLİ! Yalnızca sunucuda kullanılır. Asla NEXT_PUBLIC_ ile başlatmayın.
SUPABASE_SERVICE_ROLE_KEY=

# --- Ödeme ---
# none  : ödeme kapalı (Premium satın alınamaz, sahte ödeme yok)
# test  : TEST MODU (gerçek para çekilmez). Canlı ortamda ALLOW_TEST_PAYMENTS=true olmadan kapalıdır.
# iyzico: henüz etkin değil (üye işyeri hesabı + doküman doğrulaması gerekli)
PAYMENT_PROVIDER=none
# Test modunda webhook imzası için en az 32 karakterlik rastgele değer
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_TEST_WEBHOOK_SECRET=
ALLOW_TEST_PAYMENTS=false

# iyzico (ileride): anahtarlar YALNIZCA burada / Vercel ortam değişkenlerinde tutulur
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# --- Reklam (Google AdSense onayı alındıktan sonra) ---
# Örn: ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- Zamanlanmış görev (Vercel Cron) ---
# En az 16 karakter rastgele değer. Vercel'de CRON_SECRET olarak ekleyin.
CRON_SECRET=
